              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "trace_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "RecommendationAudit": {
        "properties": {
          "data_cutoff": {
            "title": "Data Cutoff",
            "type": "string"
          },
          "input_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Input Sha256",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "parameter_version": {
            "title": "Parameter Version",
            "type": "string"
          },
          "review_period_days": {
            "minimum": 1.0,
            "title": "Review Period Days",
            "type": "integer"
          }
        },
        "required": [
          "model_version",
          "parameter_version",
          "data_cutoff",
          "input_sha256",
          "review_period_days"
        ],
        "title": "RecommendationAudit",
        "type": "object"
      },
      "RecommendationEnvelope": {
        "properties": {
          "data": {
