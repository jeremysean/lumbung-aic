        "type": "object"
      },
      "RecommendationResult": {
        "properties": {
          "audit": {
            "$ref": "#/components/schemas/RecommendationAudit"
          },
          "budget": {
            "exclusiveMinimum": 0.0,
            "title": "Budget",
            "type": "number"
          },
