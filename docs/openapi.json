            "type": "string"
          },
          "stock_on_hand": {
            "title": "Stock On Hand",
            "type": "number"
          },
          "stockout_risk": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Stockout Risk",
            "type": "number"
          },
          "unit_cost": {
            "title": "Unit Cost",
            "type": "number"
          }
        },
        "required": [
          "sku_id",
          "category",
          "decision",
          "order_qty",
          "moq",
          "unit_cost",
          "order_cost",
          "stock_on_hand",
          "on_order",
          "horizon_days",
          "forecast_p50",
          "forecast_p90",
          "stockout_risk",
          "priority_score",
          "reason"
